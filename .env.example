NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Painel /admin/usuarios — CRUD (lista, criar, editar, excluir, redefinir senha) no servidor.
# Sem esta chave o RLS do Postgres impede ver/editar outros perfis. Nunca commitar o valor real.
# Supabase → Project Settings → API → service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=

# Testes E2E (Playwright) — usuário já cadastrado no Supabase com perfil voluntário, validador ou admin
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
